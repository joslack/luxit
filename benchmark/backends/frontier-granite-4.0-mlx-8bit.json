{
  "id": "frontier-granite-4.0-mlx-8bit",
  "name": "IBM Granite 4.0 1B Speech MLX-8bit",
  "family": "frontier-asr",
  "protocol": "jsonl-worker",
  "command": [
    "python",
    "${BENCHMARK_ROOT}/workers/frontier_asr_jsonl_worker.py"
  ],
  "description": "MLX-Audio Granite 4.0 1B Speech 8-bit conversion.",
  "model": "mlx-community/granite-4.0-1b-speech-8bit",
  "model_path": "${MODEL_DIR}/granite-4.0-1b-speech-mlx-8bit",
  "license": "Apache-2.0",
  "source_url": "https://huggingface.co/ibm-granite/granite-4.0-1b-speech",
  "required_commands": [],
  "required_paths": [
    "${MODEL_DIR}/granite-4.0-1b-speech-mlx-8bit"
  ],
  "required_python_modules": [
    "mlx_audio"
  ],
  "capabilities": {
    "languages": [
      "en",
      "fr",
      "de",
      "es",
      "pt",
      "ja"
    ],
    "prompt": true,
    "word_timestamps": false,
    "segment_timestamps": false,
    "streaming": false,
    "persistent": true
  },
  "options": {
    "runtime": "mlx_audio",
    "backend_profile": "granite_mlx",
    "model": "mlx-community/granite-4.0-1b-speech-8bit",
    "supported_languages": [
      "en",
      "fr",
      "de",
      "es",
      "pt",
      "ja"
    ],
    "supports_prompt": true,
    "supports_word_timestamps": false,
    "supports_segment_timestamps": false,
    "supports_streaming": false,
    "supports_translation": false,
    "supports_diarization": false,
    "timeout_seconds": 600,
    "load_timeout_seconds": 900
  },
  "environment": {
    "PYTHONUNBUFFERED": "1"
  },
  "setup": "Install MLX-Audio and keep the Granite conversion in MODEL_DIR. Prompt controls are task-string prompts, not arbitrary hotword lists."
}
