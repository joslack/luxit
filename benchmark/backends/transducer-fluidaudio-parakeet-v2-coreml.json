{
  "id": "transducer-fluidaudio-parakeet-v2-coreml",
  "name": "FluidAudio Parakeet TDT v2 Core ML",
  "family": "parakeet",
  "protocol": "jsonl-worker",
  "command": [
    "python3",
    "${BENCHMARK_ROOT}/workers/transducer_fluidaudio_worker.py"
  ],
  "description": "FluidAudio Core ML path for English Parakeet TDT 0.6B v2 batch transcription.",
  "model": "tdt-v2",
  "model_path": "${MODEL_DIR}/fluidaudio/parakeet-tdt-0.6b-v2-coreml",
  "license": "CC-BY-4.0 + Apache-2.0 runtime",
  "source_url": "https://huggingface.co/FluidInference/parakeet-tdt-0.6b-v2-coreml",
  "required_commands": [
    "fluidaudiocli"
  ],
  "required_paths": [
    "${MODEL_DIR}/fluidaudio/parakeet-tdt-0.6b-v2-coreml",
    "Resources/models/fluidaudio/parakeet-tdt-0.6b-v2-coreml"
  ],
  "required_python_modules": [],
  "capabilities": {
    "languages": [
      "en"
    ],
    "prompt": false,
    "word_timestamps": true,
    "segment_timestamps": true,
    "streaming": false,
    "persistent": true
  },
  "options": {
    "cli": "fluidaudiocli",
    "model_version": "tdt-v2",
    "supports_prompt": false,
    "supported_languages": [
      "en"
    ],
    "supports_language_override": false,
    "supports_word_timestamps": true,
    "supports_streaming": false,
    "output_mode": "batch"
  },
  "environment": {
    "FLUIDAUDIO_WORKER_MODE": "coreml_batch"
  },
  "setup": "Keep FluidAudio Core ML artifacts and caches in ${MODEL_DIR}/fluidaudio and pre-download artifacts only if user requests."
}
