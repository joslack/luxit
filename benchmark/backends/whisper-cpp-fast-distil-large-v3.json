{
  "id": "whisper-cpp-fast-distil-large-v3",
  "name": "whisper.cpp fast greedy (Distil large-v3)",
  "family": "whisper",
  "protocol": "command",
  "command": [
    "python3",
    "${BENCHMARK_ROOT}/workers/whisper_cpp_cli_bridge.py",
    "--backend-id",
    "whisper-cpp-fast-distil-large-v3",
    "--audio",
    "{audio}",
    "--model-path",
    "{model_path}",
    "--language",
    "{language}",
    "--prompt",
    "{prompt}",
    "--fixed-language",
    "en",
    "--threads",
    "{threads}",
    "--beam-size",
    "{beam_size}",
    "--best-of",
    "{best_of}",
    "--temperature",
    "{temperature}",
    "--temperature-fallback",
    "{temperature_fallback}",
    "--no-context",
    "{no_context}",
    "--no-timestamps",
    "{no_timestamps}",
    "--strategy",
    "{strategy}",
    "--supports-prompt",
    "{supports_prompt}",
    "--supports-language-override",
    "{supports_language_override}",
    "--supports-word-timestamps",
    "{supports_word_timestamps}",
    "--word-timestamps",
    "{word_timestamps}",
    "--flash-attention",
    "{flash_attention}",
    "--whisper-binary",
    "/opt/homebrew/opt/whisper-cpp/bin/whisper-cli"
  ],
  "description": "Installed whisper.cpp on distil-large-v3 using fast greedy settings. Distil-Whisper is treated as English-only. Cold-process inference.",
  "model": "ggml-distil-large-v3.bin",
  "model_path": "${MODEL_DIR}/ggml/ggml-distil-large-v3.bin",
  "license": "MIT",
  "source_url": "https://huggingface.co/distil-whisper/distil-large-v3-ggml",
  "required_commands": [
    "python3",
    "whisper-cli"
  ],
  "required_paths": [
    "/opt/homebrew/opt/whisper-cpp/bin/whisper-cli",
    "/opt/homebrew/opt/whisper-cpp/lib/libwhisper.dylib",
    "${BENCHMARK_ROOT}/workers/whisper_cpp_cli_bridge.py",
    "${MODEL_DIR}/ggml/ggml-distil-large-v3.bin"
  ],
  "required_python_modules": [],
  "capabilities": {
    "languages": [
      "en"
    ],
    "prompt": true,
    "word_timestamps": false,
    "segment_timestamps": false,
    "streaming": false,
    "persistent": false
  },
  "options": {
    "threads": 6,
    "beam_size": 1,
    "best_of": 1,
    "temperature": 0,
    "temperature_fallback": false,
    "no_context": true,
    "no_timestamps": true,
    "strategy": "greedy",
    "supports_prompt": true,
    "supports_language_override": false,
    "supports_word_timestamps": false,
    "flash_attention": true,
    "output_format": "json"
  },
  "environment": {},
  "setup": "Use ggml-distil-large-v3.bin artifact already staged under ${MODEL_DIR}/ggml. No downloads."
}
